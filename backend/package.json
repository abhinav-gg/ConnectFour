{
    "name": "connect-four-api",
    "version": "1.0.0",
    "description": "Connect Four API",
    "scripts": {
        "dev:api": "npx tsc && node -r tsconfig-paths/register -r ts-node/register/transpile-only --require tsconfig-paths/register dist/backend/src/api-server.js --baseUrl ./dist",
        "dev:socket": "npx tsc && node -r tsconfig-paths/register -r ts-node/register/transpile-only --require tsconfig-paths/register dist/backend/src/socket-server.js --baseUrl ./dist",
        "build": "tsc -p tsconfig.json",
        "lint": "eslint .",
        "start:api": "node -r tsconfig-paths/register -r ts-node/register/transpile-only --require tsconfig-paths/register dist/backend/src/api-server.js --baseUrl ./dist",
        "start:socket": "node -r tsconfig-paths/register -r ts-node/register/transpile-only --require tsconfig-paths/register dist/backend/src/socket-server.js --baseUrl ./dist",
        "start": "concurrently \"npm run start:api\" \"npm run start:socket\""
    },
    "dependencies": {
        "@aws-sdk/client-dynamodb": "^3.844.0",
        "@aws-sdk/lib-dynamodb": "^3.844.0",
        "@socket.io/redis-adapter": "^8.3.0",
        "@types/nodemailer": "^6.4.17",
        "argon2": "^0.41.1",
        "bullmq": "^5.56.4",
        "cookie": "^1.0.2",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "handlebars": "^4.7.8",
        "ioredis": "^5.6.1",
        "jsonwebtoken": "^9.0.2",
        "no-profanity": "^1.5.1",
        "nodemailer": "^7.0.9",
        "pg": "^8.11.3",
        "socket.io": "^4.7.4",
        "tsx": "^4.20.4",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20",
        "@types/pg": "^8.10.9",
        "@types/socket.io": "^3.0.2",
        "@typescript-eslint/eslint-plugin": "^8.16.0",
        "@typescript-eslint/parser": "^8.16.0",
        "concurrently": "^9.2.0",
        "eslint": "^8.57.1",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5"
    }
}
