{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "types": ["node"],
    "lib": ["es2020", "dom", "esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*", "./backend/src/*"],
      "@config/*": ["./config/*"],
      "@tests/*": ["./tests/*"],
      "@data/*": ["./data/*"],
      "@shared/*": ["../shared/*", "./shared/*"],
    }
  },
  "include": [
    "../shared/**/*", 
    "./tests/*",
    "./config/*",
    "./src/api-server.ts", 
    "./src/socket-server.ts", 
    "./src/controllers/api/**/*",
    "./src/lib/**/*",
    "./src/utils/**/*",
    "./src/types/**/*",
    "./src/redis/**/*",
    "./src/db/**/*",
    "src/controllers/socket/services/**/*"
  ],
  "exclude": ["node_modules"]
} 