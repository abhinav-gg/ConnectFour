{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*", "./*"],
      "@config/*": ["./config/*"],
      "@tests/*": ["./tests/*", "./*"],
      "@data/*": ["./data/*"],
      "@shared/*": ["../shared/*", "./shared/*"],
    }
  },
  "include": [
    "./tests/*",
    "./config/*",
    "src/controllers/api/**/*",
    "./src/lib/**/*",
    "../shared/**/*"
, "src/api-server.ts", "src/controllers/socket/events", "src/redis/redis.ts"  ],
  "exclude": ["node_modules"]
} 