{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "outDir": "./dist",
    "strict": true,
    "types": ["node"],
    "lib": ["es2020", "dom", "esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*", "./backend/src/*"],
      "@config/*": ["./config/*"],
      "@tests/*": ["./tests/*"],
      "@data/*": ["./data/*"],
      "@shared/*": ["../shared/*", "./shared/*"],
    }
  },
  "include": [
    "../shared/**/*", 
    "./tests/*",
    "./config/*",
    "./src/**/*",
  ],
  "exclude": ["node_modules"]
} 