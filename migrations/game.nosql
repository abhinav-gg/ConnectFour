// Add prefixes

GAME:
{
  "p": "<gameUUID>",                                // Game UUID as PK
  "s": "ABC123",                                    // Shortcode (nullable)
  "u": ["user1", "user2"],                          // Ordered list of player IDs
  "d": Buffer,                                      // Game data (binary/base64)
  "i": number,                                      // GameInfo 8 bytes NOT GAMEMODE
  "r": 3                                            // Result (4-bit number)
}

GAMEPLAYERS
{
  "p": "<userUUID>",            // Partition Key: player ID
  "s": "<gameUUID>",     // Sort Key: game ID
  "t": 1699852800,         // Timestamp (unix time)
  "m": 3,                  // Gamemode ID (integer)
  "e": 1090,               // Starting ELO
  "d": 5                   // Delta ELO (optional)
}


SHORTCODEMAP
{
  "p": "ABC123",              // Shortcode as PK with prefix 's#'
  "g": "123e4567-e89b-12d3-a456-426614174000"  // Game ID this shortcode maps to
}