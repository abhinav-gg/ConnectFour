
GAME:
{
  "p": "<gameUUID>",                                // Game UUID as PK
  "c": "ABC123",                                    // Sort Key: Shortcode (nullable)
  "u": ["user:1", "user:2"],                        // Ordered list of player IDENTITIES
  "d": Buffer,                                      // Game data (binary/base64)
  "i": number,                                      // GameInfo ID (integer)
  "r": 3                                            // Result (4-bit number)
}

GAMEPLAYERS
{
  "p": "<userUUID>",       // Partition Key: player UUIDS ( all assumed to be users here )
  "s": "<gameUUID>",       // Sort Key: game ID
  "t": 1699852800,         // LSI: Timestamp (unix time)
  "m": 3,                  // LSI: GameInfo ID (integer)
  "i": 0,                  // Player index 
  "e": 1090,               // Starting ELO (optional)
  "d": 5                   // Delta ELO (optional)
  "r": 0                   // Result (optional)
  "a": 99.764              // Accuracy (optional)
}


SHORTCODEMAP
{
  "p": "ABC123",              // Shortcode as PK with prefix 's#'
  "g": "<gameUUID>"           // Game ID this shortcode maps to
}

GRAPHCACHE
{
  "p": "<userUUID>"
  "d": "day"
  "g": 2 //GameInfo ID (integer)
  "e": 90 // elo at the end of the day (updated at the end of each game played that day...)
}

PUZZLES
{
  "p": "STANDARD_PUZZLE" // default key
  "r": 1001.1 // ELO rating of the puzzle
  "m": BUFFER // binary data of the puzzle 
  
}


